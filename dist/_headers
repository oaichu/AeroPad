  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-rRmEeDjKJ6tUGkOXoxrQrqrozHtDxhL7coK07vNZqIY='; style-src 'self' 'sha256-RO8FwuYPG7Nbx0KIZIQdUvNfe3ZNc1bIN/5f5WK4RBE=' 'sha256-eog/l5ObiuRCXHtjvPoE9KQwnL37YKGS1LwYssVDBPw='; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
